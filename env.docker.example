# Copy to `.env` in the repo root (same folder as docker-compose.yml).
# Docker Compose loads this file automatically for ${VAR} substitution.

APP_PORT=8080

# Host path bind-mounted into the API container for user-study JSONL logs
# (survives image rebuilds and `docker compose up --build`). On the VM, copy or
# rsync this directory for analysis.
STUDY_LOG_HOST_DIR=./study_logs

# Required for AI analysis.
ANTHROPIC_API_KEY=

# Required for persisted users, papers, mappings, and conversations. Apply the
# migrations in supabase/migrations to this project before starting DeepRead.
SUPABASE_URL=
# Server-only key from Supabase (starts with `sb_secret_`). Never expose this
# value through Vite variables or frontend code.
SUPABASE_SECRET_KEY=
# Temporary fallback for deployments still using a legacy service-role key.
SUPABASE_KEY=

# Optional integrations.
BRAVE_SEARCH_API_KEY=
BRAVE_ANSWERS_API_KEY=
COHERE_API_KEY=
WANDB_API_KEY=
WEAVE_PROJECT=gardoslab/deepread
# Set to false to enable Weave tracing.
WEAVE_DISABLED=true
